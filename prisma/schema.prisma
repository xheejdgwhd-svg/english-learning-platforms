// ==========================
// Prisma schema (full)
// ==========================

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x — чтобы бинарники Prisma подходили под среду Netlify
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Обязательно выставь DATABASE_URL в Netlify и локально (.env)
  // Если Supabase — добавь &sslmode=require
  url      = env("DATABASE_URL")
}

// ==========================
// NextAuth models
// ==========================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // связь с прогрессами
  progresses Progress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================
// App models
// ==========================

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String?  @db.Text
  level     String?  // A1/A2/B1/B2/C1 — можно позже заменить на enum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progresses Progress[]

  @@index([createdAt])
}

model Progress {
  id        String         @id @default(cuid())
  userId    String
  lessonId  String
  status    ProgressStatus @default(IN_PROGRESS)
  score     Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}
